{
  "name": "@form-lens/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed client for the FormLens API, generated by Orval from apps/api/openapi.json.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "orval",
    "generate:check": "node scripts/generate-check.mjs",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "orval": "8.47.0",
    "typescript": "^7.0.2"
  },
  "nx": {
    "targets": {
      "generate": {
        "inputs": [
          "{projectRoot}/orval.config.ts",
          "{projectRoot}/src/fetcher.ts",
          "{workspaceRoot}/apps/api/openapi.json"
        ],
        "outputs": [
          "{projectRoot}/src/generated"
        ]
      },
      "generate:check": {
        "cache": true,
        "inputs": [
          "{projectRoot}/orval.config.ts",
          "{projectRoot}/scripts/*",
          "{projectRoot}/src/**/*",
          "{workspaceRoot}/apps/api/openapi.json"
        ]
      }
    }
  }
}
