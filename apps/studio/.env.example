# File for app envs template

# Logging configuration
# LOG_LEVEL can be: fatal, error, warn, info, debug, trace
LOG_LEVEL=debug

# Where the FormLens API (apps/api) listens
FORMLENS_API_URL=http://localhost:8000

# Largest document the Studio accepts for upload, in MB (default 25). next.config.ts reads it when the server starts,
# so a change needs a restart.
FORMLENS_MAX_UPLOAD_MB=25
