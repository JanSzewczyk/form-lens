# File for app envs template

# Logging configuration
# LOG_LEVEL can be: fatal, error, warn, info, debug, trace
LOG_LEVEL=debug

# Where the FormLens API (apps/api) listens
FORMLENS_API_URL=http://localhost:8000

# Largest document the Studio accepts for upload, in MB (default 25). The request body limit is fixed when the app is
# built, so raising it needs a rebuild with the value set at build time (Docker: --build-arg FORMLENS_MAX_UPLOAD_MB=50)
# and the same value at runtime; at runtime alone it can only lower the limit (a higher value is capped, with a warning).
FORMLENS_MAX_UPLOAD_MB=25
